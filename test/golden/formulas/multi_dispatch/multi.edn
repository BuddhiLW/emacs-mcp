"(ns acme.events.multi\n  (:require [hive-dsl.result :as r]))\n\n(defmulti handle-event\n  \"Open dispatch port on :event/kind. Contract: [:map [:event/kind :keyword] [:event/payload [:map [:v :int]]]] -> [:map [:ok :boolean]].\\nUnhandled dispatch -> r/err :acme.events/unhandled. Extend via defmethod.\"\n  :event/kind :default\n  ::unhandled)\n\n(defmethod handle-event ::unhandled\n  [subject]\n  (r/err :acme.events/unhandled\n         {:dispatch (:event/kind subject) :subject subject}))\n"
