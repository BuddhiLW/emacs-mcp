"(ns acme.events.multi-test\n  (:require [acme.events.methods :as methods]\n            [acme.events.multi :as multi]\n            [acme.events.schema :as schema]\n            [clojure.test :refer [deftest is testing]]\n            [hive-dsl.result :as r]))\n\n(deftest handle-event-contract\n  (let [base {:event/kind :-! :event/payload {:v 1}}]\n    (testing \"dispatch totality: unknown kind hits the default err method\"\n      (is (r/err? (multi/handle-event (assoc base :event/kind ::unknown)))))\n    (testing \"declared variants are registered\"\n      (is (contains? (methods multi/handle-event) :created))\n      (is (contains? (methods multi/handle-event) :deleted)))\n    (testing \"LSP: implemented variants satisfy the out contract\"\n      (doseq [k [:created :deleted]]\n        (let [res (try (multi/handle-event (assoc base :event/kind k)) (catch clojure.lang.ExceptionInfo _ ::stub))]\n          (is\n           (or (= ::stub res) (schema/validate [:map [:ok :boolean]] res))\n           (str k)))))))\n"
