"(ns acme.time.core-test\n  (:require [acme.time.adapters.in-memory :as ad]\n            [acme.time.boundary :as boundary]\n            [acme.time.core :as core]\n            [acme.time.port :as port]\n            [acme.time.schema :as schema]\n            [clojure.test :refer [deftest is]]\n            [clojure.test.check.clojure-test :refer [defspec]]\n            [clojure.test.check.properties :as prop]\n            [hive-schemas.test :as hst]\n            [hive-test.golden :as hgolden]\n            [hive-test.golden.store :as gstore]\n            [hive-test.mutation :as hmut]))\n\n(hst/deftrifecta-from-schema now-millis-tests\n  acme.time.core/now-millis\n  {:in (schema/schema :acme.time/clock)\n   :out (schema/schema :acme.time/millis)\n   :rel (fn [qa-port qa-out]\n          (= qa-out (port/now-millis qa-port)))\n   :contract true\n   :num-tests 200\n   :mutation false})\n\n(defspec now-millis-delegation-property 200\n  (prop/for-all [qa-expected (schema/generator :acme.time/millis)]\n    (let [qa-calls (atom [])\n          qa-port (reify port/Clock\n  (now-millis [_]\n    (swap! qa-calls conj [:now-millis])\n    qa-expected))\n          qa-actual (core/now-millis qa-port)]\n      (and (= qa-expected qa-actual)\n           (= [[:now-millis]] @qa-calls)\n           (schema/validate :acme.time/millis qa-actual)))))\n\n(hmut/deftest-mutations now-millis-mutation\n  acme.time.core/now-millis\n  [[\"bypass-port\" (fn [& _] (Object.))]]\n  (fn []\n    (let [qa-expected 1\n          qa-calls (atom [])\n          qa-port (reify port/Clock\n  (now-millis [_]\n    (swap! qa-calls conj [:now-millis])\n    qa-expected))\n          qa-actual (core/now-millis qa-port)]\n      (is (= qa-expected qa-actual))\n      (is (= [[:now-millis]] @qa-calls))\n      (is (schema/validate :acme.time/millis qa-actual)))))\n\n(deftest now-millis-golden\n  (let [qa-path \"formula/dip-port/acme.time/now-millis.edn\"\n        qa-expected-snapshot\n        {:arguments []\n         :output 1}\n        qa-port (ad/make-in-memory {:now-millis 1})\n        qa-actual-snapshot\n        {:arguments []\n         :output (core/now-millis qa-port)}]\n    (binding [hgolden/*store*\n              (gstore/memory-store {qa-path qa-expected-snapshot})]\n      (hgolden/assert-golden qa-path qa-actual-snapshot))))\n\n(defspec now-millis-boundary-integration 200\n  (prop/for-all [qa-expected (schema/generator :acme.time/millis)]\n    (let [qa-calls (atom [])\n          qa-port (reify port/Clock\n  (now-millis [_]\n    (swap! qa-calls conj [:now-millis])\n    qa-expected))\n          qa-actual (boundary/now-millis! qa-port)]\n      (and (= qa-expected qa-actual)\n           (= [[:now-millis]] @qa-calls)\n           (schema/validate :acme.time/millis qa-actual)))))\n\n(def formula-test-manifest\n  {:version 2, :formula :dip-port, :status :planned, :planned-cases 200, :cover-anchor-kind :materialized-file, :subject-kind :qualified-var, :tests [{:facet :test/conformance, :test-var \"acme.time.core-test/now-millis-tests-conformance\", :engine :test.check, :subjects #{\"acme.time.core/now-millis\" \"acme.time.port/now-millis\" \"acme.time.schema/port-schema\" \"acme.time.schema/schema\"}, :covers #{\"file:src/acme/time/adapters/in_memory.clj\" \"file:src/acme/time/core.clj\" \"file:src/acme/time/port.clj\" \"file:src/acme/time/schema.cljc\"}, :planned-cases 200} {:facet :test/relation, :test-var \"acme.time.core-test/now-millis-tests-relation\", :engine :test.check, :subjects #{\"acme.time.core/now-millis\" \"acme.time.port/now-millis\" \"acme.time.schema/port-schema\" \"acme.time.schema/schema\"}, :covers #{\"file:src/acme/time/adapters/in_memory.clj\" \"file:src/acme/time/core.clj\" \"file:src/acme/time/port.clj\" \"file:src/acme/time/schema.cljc\"}, :planned-cases 200} {:facet :test/contract, :test-var \"acme.time.core-test/now-millis-tests-contract\", :engine :malli.generator/check, :subjects #{\"acme.time.core/now-millis\" \"acme.time.port/now-millis\" \"acme.time.schema/port-schema\" \"acme.time.schema/schema\"}, :covers #{\"file:src/acme/time/adapters/in_memory.clj\" \"file:src/acme/time/core.clj\" \"file:src/acme/time/port.clj\" \"file:src/acme/time/schema.cljc\"}} {:facet :test/property, :test-var \"acme.time.core-test/now-millis-delegation-property\", :engine :test.check, :subjects #{\"acme.time.core/now-millis\" \"acme.time.port/now-millis\" \"acme.time.schema/generator\" \"acme.time.schema/validate\"}, :covers #{\"file:src/acme/time/core.clj\" \"file:src/acme/time/port.clj\" \"file:src/acme/time/schema.cljc\"}, :planned-cases 200} {:facet :test/mutation, :test-var \"acme.time.core-test/now-millis-mutation\", :engine :hive-test.mutation, :subjects #{\"acme.time.core/now-millis\" \"acme.time.port/now-millis\" \"acme.time.schema/validate\"}, :covers #{\"file:src/acme/time/core.clj\" \"file:src/acme/time/port.clj\" \"file:src/acme/time/schema.cljc\"}, :planned-cases 1} {:facet :test/golden, :test-var \"acme.time.core-test/now-millis-golden\", :engine :hive-test.golden, :subjects #{\"acme.time.adapters.in-memory/make-in-memory\" \"acme.time.core/now-millis\" \"acme.time.port/now-millis\"}, :covers #{\"file:src/acme/time/adapters/in_memory.clj\" \"file:src/acme/time/core.clj\" \"file:src/acme/time/port.clj\" \"file:src/acme/time/schema.cljc\"}, :planned-cases 1, :oracle :generated-in-memory-reference} {:facet :test/integration, :test-var \"acme.time.core-test/now-millis-boundary-integration\", :engine :test.check, :subjects #{\"acme.time.boundary/now-millis!\" \"acme.time.core/now-millis\" \"acme.time.port/now-millis\" \"acme.time.schema/generator\" \"acme.time.schema/validate\"}, :covers #{\"file:src/acme/time/boundary.clj\" \"file:src/acme/time/core.clj\" \"file:src/acme/time/port.clj\" \"file:src/acme/time/schema.cljc\"}, :planned-cases 200}], :skips #:test{:lsp {:reason :throwing-adapter-stubs, :adapters #{:system}}}})\n"
