"(ns acme.time.schema\n  (:require [acme.time.port :as port]\n            [clojure.test.check.generators :as gen]\n            [malli.core :as m]\n            [malli.generator :as mg]\n            [malli.registry :as mr]))\n\n(def value-object-schemas\n  (array-map\n   :acme.time/millis [:int {:min 1}]))\n\n(def value-object-dependencies\n  #:acme.time{:millis #{}})\n\n(def value-object-load-order\n  [:acme.time/millis])\n\n(def value-object-registry\n  (mr/composite-registry\n   (m/default-schemas)\n   value-object-schemas))\n\n(defn- value-object-schema\n  [form]\n  (m/schema form {:registry value-object-registry}))\n\n(defn- value-object-generator\n  [form]\n  (mg/generator (value-object-schema form)))\n\n(defn- generated-port\n  [seed]\n  (reify port/Clock\n    (now-millis [_]\n      (get seed :now-millis))))\n\n(def port-schema\n  (value-object-schema\n   [:fn\n    {:gen/gen\n     (gen/fmap generated-port\n               (value-object-generator [:map [:now-millis :acme.time/millis]]))}\n    (fn [value]\n      (satisfies? port/Clock value))]))\n\n(def registry\n  (mr/composite-registry\n   value-object-registry\n   {:acme.time/clock port-schema}))\n\n(defn schema\n  [form]\n  (m/schema form {:registry registry}))\n\n(defn validate\n  [form value]\n  (m/validate form value {:registry registry}))\n\n(defn generator\n  [form]\n  (mg/generator (schema form)))\n\n(defn generate\n  ([form]\n   (mg/generate (schema form)))\n  ([form options]\n   (mg/generate (schema form) options)))\n"
