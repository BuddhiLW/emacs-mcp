"(ns acme.time.adapters.in-memory\n  (:require [acme.time.port :as port]\n            [acme.time.schema :as schema]))\n\n(defrecord InMemory [state]\n  port/Clock\n  (now-millis [_] (get @state :now-millis)))\n\n(defn make-in-memory\n  \"Reference adapter over a seeded state atom keyed by method name.\"\n  [seed]\n  (->InMemory (atom seed)))\n\n(def seed-schema\n  (schema/schema [:map [:now-millis :acme.time/millis]]))\n\n(def seed-generator\n  (schema/generator seed-schema))\n"
