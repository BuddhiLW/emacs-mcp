 :grounding
 {:datalog
  [:find
   ?vc
   ?ca
   ?cb
   ?rc
   ?ch
   ?gc
   :in
   $
   ?path
   ?scope
   :where
   [?d :disc/path ?path]
   [?d :disc/project-id ?scope]
   [?d :disc/volatility-class ?vc]
   [?d :disc/certainty-alpha ?ca]
   [?d :disc/certainty-beta ?cb]
   [(get-else $ ?d :disc/read-count 0) ?rc]
   [(get-else $ ?d :disc/content-hash "") ?ch]
   [(get-else $ ?d :disc/git-commit "") ?gc]],
  :inputs ["src/foo.clj" "proj"],
  :limit 1},
