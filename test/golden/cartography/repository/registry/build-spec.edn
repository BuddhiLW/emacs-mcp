     :kg-edge/to
     :kg-edge/relation
     :kg-edge/confidence
     :kg-edge/id])
   :in
   $
   [?n ...]
   ?rel
   [?scope ...]
   :where
   [?e :kg-edge/from ?n]
   [?e :kg-edge/relation ?rel]
   [?e :kg-edge/scope ?scope]],
  :inputs [["n1"] :depends-on ["s1"]],
  :limit 10},
