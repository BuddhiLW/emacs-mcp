<!--
  Focused JFR settings for hunting the hive-mcp datalevin-tuple heap leak
  (~70M 3-element datalog tuples + 37M datalevin.bits.Retrieved held statically).

  The workhorse is jdk.OldObjectSample: JFR keeps a bounded ring of sampled
  allocations that SURVIVE GC and, at dump time (with path-to-gc-roots=true),
  emits each with its allocation stack AND its reference chain to a GC root.
  That reference chain names the retainer — the MAT-substitute that works
  in-process, at boot, with negligible RAM (unlike a dominator tree, which is
  impossible here because the leak re-inflates to ~85% RAM before MAT can load).

  Started at JVM boot via -XX:StartFlightRecording in the :dev/:nrepl aliases so
  the ENTIRE leak growth is captured from a cold JVM (OldObjectSample only sees
  allocations made after it starts). Kept deliberately minimal — no CPU method
  sampling, no lock/IO events — so overhead on the live coordinator is tiny and
  the buffer stays dominated by leak-relevant data.
-->
<configuration version="2.0" label="hive-leak"
               description="Old-object leak sampling for the hive-mcp heap leak"
               provider="hive">

  <!-- THE leak finder: surviving-allocation samples + GC-root paths. -->
  <event name="jdk.OldObjectSample">
    <setting name="enabled">true</setting>
    <setting name="stackTrace">true</setting>
    <!-- cutoff=0 => keep every sampled old object (no age floor). -->
    <setting name="cutoff">0 ns</setting>
  </event>

  <!-- Light allocation-site context (throttled) to corroborate the source path. -->
  <event name="jdk.ObjectAllocationSample">
    <setting name="enabled">true</setting>
    <setting name="throttle">150/s</setting>
    <setting name="stackTrace">true</setting>
  </event>

  <!-- Cheap GC context to correlate growth with collection cycles. -->
  <event name="jdk.GarbageCollection">
    <setting name="enabled">true</setting>
  </event>
  <event name="jdk.GCHeapSummary">
    <setting name="enabled">true</setting>
  </event>
  <event name="jdk.G1HeapSummary">
    <setting name="enabled">true</setting>
  </event>
</configuration>
