{;; hive-dsl defadt macro hook — expands to 4 def forms so generated
 ;; type/ctor/pred/coercer symbols resolve.
 ;; hive-di defconfig macro hook — expands to <Name>-fields / -schema /
 ;; resolve-<Name> defs so generated symbols resolve.
 :hooks {:analyze-call {hive-dsl.adt/defadt hive-dsl.hooks.defadt/defadt
                        hive-di.core/defconfig hive-di.hooks.defconfig/defconfig
                        hive-dsl.result/guard            hooks.hive-dsl.result/guard
                        hive-dsl.result/rescue           hooks.hive-dsl.result/rescue
                        hive-dsl.result/rescue-log       hooks.hive-dsl.result/rescue-log
                        hive-dsl.result/rescue-interrupt hooks.hive-dsl.result/rescue-interrupt
                        hive-dsl.result/try-effect       hooks.hive-dsl.result/try-effect
                        hive-dsl.result/try-effect*      hooks.hive-dsl.result/try-effect*
                        hive-dsl.result/let-ok           hooks.hive-dsl.result/let-ok
                        hive-mcp.dns.result/let-ok       hooks.hive-dsl.result/let-ok}}

 :lint-as {;; multi_dsl_e2e_test when-resolved macro binds a single symbol like if-let
           hive-mcp.tools.multi-dsl-e2e-test/when-resolved clojure.core/if-let
           ;; pldb/db-rel defines relations - column names are schema, not symbols
           clojure.core.logic.pldb/db-rel clojure.core/declare
           ;; with-entry binds entry symbol like let
           hive-mcp.tools.memory.core/with-entry clojure.core/let
           ;; manifold.deferred macros - let-flow binds like let
           manifold.deferred/let-flow clojure.core/let
           manifold.deferred/let-flow' clojure.core/let
           manifold.deferred/loop clojure.core/let
           ;; let-ok now uses a hook (see :hooks above) — :lint-as let can't
           ;; model its interleaved `:let` bindings. ok-> threads the unwrapped
           ;; ok value as the first arg, exactly like clojure.core/->.
           hive-mcp.dns.result/ok-> clojure.core/->
           hive-dsl.result/ok-> clojure.core/->
           ;; hive-di defmanifest defines a manifest var like def
           hive-di.addon/defmanifest clojure.core/def
           ;; pool with-connection binds like with-open
           hive-mcp.addons.pool/with-connection clojure.core/with-open
           ;; test.check defspec defines test vars like deftest
           clojure.test.check.clojure-test/defspec clojure.test/deftest
           ;; hive-di defconfig-tests: first arg is the config type NAME (used
           ;; for the generated test vars), rest is body — model like deftest so
           ;; the type name isn't flagged unresolved.
           hive-di.testing/defconfig-tests clojure.test/deftest
           ;; test.check for-all binds like let
           clojure.test.check.properties/for-all clojure.core/let
           ;; hive-test property macros expand to defspec
           hive-test.properties/defprop-total clojure.test/deftest
           hive-test.properties/defprop-idempotent clojure.test/deftest
           hive-test.properties/defprop-roundtrip clojure.test/deftest
           hive-test.properties/defprop-complement clojure.test/deftest
           hive-test.properties/defprop-fsm-terminates clojure.test/deftest
           hive-test.properties/defprop-commutative clojure.test/deftest
           hive-test.properties/defprop-concurrent-safe clojure.test/deftest
           hive-test.properties/defprop-invariant clojure.test/deftest
           hive-test.properties/defprop-metamorphic clojure.test/deftest
           hive-test.properties/defprop-sequential-equiv clojure.test/deftest
           hive-test.properties/defprops-monad clojure.test/deftest
           ;; hive-test golden macros expand to deftest
           hive-test.golden/deftest-golden clojure.test/deftest
           hive-test.golden/deftest-golden-fn clojure.test/deftest
           ;; hive-test mutation macros expand to deftest
           hive-test.mutation/deftest-mutations clojure.test/deftest
           hive-test.mutation/deftest-mutation-witness clojure.test/deftest
           ;; hive-test trifecta composite
           hive-test.trifecta/deftrifecta clojure.test/deftest
           hive-test.trifecta/deftest-facets clojure.test/deftest}

 :linters {;; Duplicate aliases are redundant but harmless — warn, don't block CI.
           :conflicting-alias {:level :warning}
           :unresolved-var
           {:exclude [;; core.logic vars that may not be in kondo's database
                      clojure.core.logic/membero
                      ;; datahike.api - dynamically loaded, kondo can't resolve
                      datahike.api/database-exists?
                      datahike.api/create-database
                      datahike.api/connect
                      datahike.api/transact
                      datahike.api/q
                      datahike.api/db
                      datahike.api/entity
                      datahike.api/pull
                      datahike.api/release
                      datahike.api/delete-database
                      datahike.api/history
                      datahike.api/as-of
                      datahike.api/since]}}

 ;; Per-namespace configuration for core.logic files
 :config-in-ns
 {hive-mcp.swarm.logic
  {:linters {:unresolved-symbol {:level :off}
             :syntax {:level :off}}}
  hive-mcp.swarm.logic.predicates
  {:linters {:unresolved-symbol {:level :off}
             :syntax {:level :off}}}
  ;; websocket uses manifold.deferred/let-flow which kondo has trouble with aliases
  hive-mcp.channel.websocket
  {:linters {:unresolved-symbol {:exclude [socket]}}}}}
