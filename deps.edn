{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        org.clojure/core.async {:mvn/version "1.7.701"}

        ;; MCP SDK - BuddhiLW fork with async handler fix
        ;; Includes: graceful stdin EOF fix, dep upgrades, lsp4clj lint fix
        io.github.buddhilw/mcp-clojure-sdk
        {:git/tag "v0.1.1" :git/sha "49203a6"
         :exclusions [org.apache.logging.log4j/log4j-slf4j2-impl]}

        ;; Python interop for Claude Agent SDK bridge
        clj-python/libpython-clj {:mvn/version "2.026"}

        ;; nREPL client support
        nrepl/bencode {:mvn/version "1.2.0"}

        ;; Aleph for robust async TCP/networking (replaces custom sockets)
        aleph/aleph {:mvn/version "0.9.7"}
        manifold/manifold {:mvn/version "0.5.0"}

        ;; Logic programming for swarm hivemind coordination
        org.clojure/core.logic {:mvn/version "1.1.1"}

        ;; Time handling
        clj-time/clj-time {:mvn/version "0.15.2"}

        ;; Datascript for in-memory graph storage (GraphStore backend)
        datascript/datascript {:mvn/version "1.7.8"}
        ;; me.tonsky namespace for datascript/datahike: provided by local 0.3.118 jar.
        ;; org.replikativ namespace for Datahike: provided by addon (0.4.119).
        ;; Different group IDs → both on classpath, non-overlapping namespaces.
        persistent-sorted-set/persistent-sorted-set-compat
        {:local/root "lib/persistent-sorted-set-0.3.118.jar"}

        ;; Datalevin for durable graph storage (GraphStore backend, optional)
        ;; LMDB-backed Datalog — requires Java 21+
        datalevin/datalevin {:local/root "../clones-ref/datalevin"}

        ;; sci pinned to latest ecosystem-wide. Requires overarch consumed as
        ;; source (hive-overarch), not its AOT uberjar which bundles older sci.
        org.babashka/sci {:mvn/version "0.13.53"}

        ;; Datahike for immutable graph storage with branching/time-travel
        ;; Content-addressable, supports branch/merge for multi-ling exploration
        ;; Part of replikativ ecosystem (pairs with yggdrasil)
        org.replikativ/datahike {:mvn/version "0.8.1719"}

        ;; Proximum — pure-JVM HNSW vector index with git-like versioning.
        ;; STORAGE-2 phase 2: backs the :carto-vec / :memory-vec slots
        ;; via hive-mcp.knowledge-graph.store.proximum/ProximumVecStore.
        ;; SIMD via Java Vector API (--add-modules jdk.incubator.vector).
        ;; Late-bound through requiring-resolve so a missing jar surfaces
        ;; as :slot/factory-failed rather than a JVM crash.
        org.replikativ/proximum {:mvn/version "0.1.24"}

        ;; Logging - SLF4J with Logback backend
        ;; clojure.tools.logging provides the Clojure facade
        ;; logback-classic is the SLF4J implementation
        ;; logstash-encoder provides JSON output for Loki/ELK ingestion
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        ch.qos.logback/logback-classic {:mvn/version "1.5.18"}
        net.logstash.logback/logstash-logback-encoder {:mvn/version "8.1"}
        ;; Keep Timbre for gradual migration (existing code uses it)
        ;; It will log to its own backend, not SLF4J
        com.taoensso/timbre {:mvn/version "6.8.0"}

        ;; Schema validation (malli)
        metosin/malli {:mvn/version "0.20.1"}

        ;; Chroma vector database client - BuddhiLW fork with v2 API support
        io.github.buddhilw/clojure-chroma-client
        {:git/tag "v0.1.0-hive" :git/sha "e575d5a"}

        ;; for openrouter integration
        clj-http/clj-http {:mvn/version "3.13.1"}

        ;; YAML parsing for seed memory frontmatter
        clj-commons/clj-yaml {:mvn/version "1.0.29"}

        ;; D-Bus client for native desktop notifications
        com.lambdaisland/dbus-client {:mvn/version "0.2.15"}

        ;; Development - tracing (hot reload via hive-hot)
        org.clojure/tools.trace {:mvn/version "0.9.0"}

        ;; clj-kondo for code analysis (call graphs, linting)
        ;; Exclude log4j-slf4j2-impl to avoid conflict with slf4j-timbre
        clj-kondo/clj-kondo {:mvn/version "2026.01.19"
                             :exclusions [org.apache.logging.log4j/log4j-slf4j2-impl]}

        ;; hive-events - re-frame inspired event system for JVM
        ;; v0.4.0 adds sub-FSM composition + multi-dispatch
        io.github.hive-agi/hive-events
        {:git/tag "v0.5.2" :git/sha "24a58a1"}

        ;; hive-hot - unified hot-reload with events integration
        io.github.hive-agi/hive-hot
        {:git/tag "v0.1.2" :git/sha "9b16c87"}

        ;; Prometheus metrics - iapetos provides idiomatic Clojure wrapper
        ;; CLARITY-T: Telemetry first - observable system
        ;; hotspot collector provides JVM metrics (memory, GC, threads)
        clj-commons/iapetos {:mvn/version "0.1.14"}
        io.prometheus/simpleclient_hotspot {:mvn/version "0.16.0"}

        ;; NATS client for push-based drone notifications
        io.nats/jnats {:mvn/version "2.21.1"}

        ;; java-diff-utils for proper unified diff computation (hunks, context)
        ;; Used by drone diff protocol for token-efficient diff storage
        io.github.java-diff-utils/java-diff-utils {:mvn/version "4.15"}
        org.replikativ/yggdrasil {:mvn/version "0.2.23"}

        ;; Kabel — WebSocket transport for distributed Datahike writer backend
        ;; Symmetric peer-to-peer with middleware, transit/fressian serialization
        ;; Used by :kabel writer backend for real-time reactive KG writes
        io.replikativ/kabel {:mvn/version "0.3.92"}

        ;; Process execution - babashka.process for CLI wrappers
        ;; Used by overarch, scc, and other CLI tool integrations
        babashka/process {:mvn/version "0.6.25"}

        ;; hive-dsl — Result monad, rescue/guard DSL, error taxonomy
        io.github.hive-agi/hive-dsl
        {:git/tag "v0.5.1" :git/sha "335869e"}

        ;; hive-spi — pure SPI contract leaf (protocols + schemas + ADTs, no impls).
        ;; REQUIRED at compile time by core namespaces, not just tests:
        ;;   hive_mcp/diag/{sizer,boot,probe,profiler,cache_datahike,clinic}.clj
        ;;     -> hive-spi.diag.{ports,schema}
        ;;   hive_mcp/protocols/workflow.clj -> hive-spi.workflow.engine   (HWF2-D1b)
        ;;   hive_mcp/workflows/strategy.clj -> hive-spi.workflow.strategy (HWF2-D1b)
        ;; Sibling :local/root (not a git coord): hive-spi's only remote is a
        ;; private Gitea (git@gitea.hive-mcp.com:buddhilw/hive-spi.git), so an
        ;; io.github.* coord cannot resolve it. Same shape as the datalevin entry
        ;; above. Once hive-spi is published, switch to {:git/tag :git/sha}.
        io.github.hive-agi/hive-spi {:local/root "../hive-spi"}

        ;; hive-addon — standalone IAddon contract (leaf lib). hive-mcp.addons.protocol
        ;; re-exports it via def-aliases so the ~30 monorepo addon implementors can
        ;; depend on hive-addon instead of compile-depending on hive-mcp.
        io.github.hive-agi/hive-addon
        {:git/tag "v0.1.0" :git/sha "89e299f"}

        ;; hive-di — declarative typed config resolution (defconfig/env/literal)
        ;; Used by hive-mcp.embeddings.env-config and downstream addons.
        io.github.hive-agi/hive-di {:git/tag "v0.3.1" :git/sha "ab63fd0"}

        ;; hive-milvus — Milvus vector database addon (IMemoryStore via IAddon)
        ;; Auto-discovered via META-INF/hive-addons/milvus.edn manifest.
        ;; Overrides default Chroma store when Milvus is reachable.
        io.github.hive-agi/hive-milvus {:git/tag "v0.2.3" :git/sha "aa0ebdf"}

        ;; hive-weave — Parallel utilities (bounded-pmap) used by project/tree.clj
        io.github.hive-agi/hive-weave {:git/tag "v0.2.5" :git/sha "5895a2a"}

        ;; hive-emacs — Emacs vessel addon (IEditor, daemon, CIDER/Magit/Projectile)
        io.github.hive-agi/hive-emacs {:git/tag "v0.4.2" :git/sha "3b3b0f6"}

        ;; hive-proximum — temporal/bitemporal memory backend (IMemoryStore via IAddon)
        ;; Auto-discovered via META-INF/hive-addons/hive-proximum.edn manifest.
        ;; Stub store until backend impl lands (task 486248c0).
        io.github.hive-agi/hive-proximum {:git/tag "v0.1.3" :git/sha "835a36c"}

        ;; hive-ttracking — telemetry/timing (timed-query, track*, bench*).
        ;; Consumed by catchup.clj and siblings (bundle/hydration/hierarchy).
        io.github.hive-agi/hive-ttracking {:git/tag "v0.1.3" :git/sha "13eab91"}

        ;; hive-system — system-level abstractions (IProcess, INetwork,
        ;; process liveness, secrets, shell, redaction). Single source of
        ;; truth for "is this pid alive?", `kill -0` semantics, etc.
        ;; NOTE: process.liveness ns is post-v0.2.1 — when the next tag is
        ;; cut, bump :git/sha here and drop the local.deps.edn override.
        io.github.hive-agi/hive-system {:git/tag "v0.2.4" :git/sha "0706c57"}

        ;; Integrant — lifecycle framework for component-based systems
        ;; Replaces monolithic start! with declarative system map + profile merging
        integrant/integrant {:mvn/version "1.0.1"}
        ;; meta-merge for deep-merging profile EDN over base system.edn
        meta-merge/meta-merge {:mvn/version "1.0.0"}
}

 :aliases
 {:mcp
  {:exec-fn hive-mcp.server.core/start!
   :exec-args {}
   :extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                cider/cider-nrepl {:mvn/version "0.58.0"}}
   ;; Heap cap, G1GC tuning, string dedup for prompt/response data,
   ;; bounded core.async pool, Netty access, aggressive GC return-to-OS
   :jvm-opts ["-Xmx8g"
              "-Xms2g"
              "-XX:+UseG1GC"
              "-XX:MaxGCPauseMillis=200"
              "-XX:+UseStringDeduplication"
              "-XX:G1PeriodicGCInterval=60000"
              "-XX:+G1PeriodicGCInvokesConcurrent"
              "-XX:MinHeapFreeRatio=20"
              "-XX:MaxHeapFreeRatio=40"
              "-XX:G1HeapRegionSize=4m"
              "-XX:+HeapDumpOnOutOfMemoryError"
              "-XX:+ExitOnOutOfMemoryError"
              "-Dclojure.core.async.pool-size=8"
              "--add-opens=java.base/jdk.internal.misc=ALL-UNNAMED"
              "--add-opens=java.base/java.nio=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"]}

  ;; One-off KG datahike rebuild (drop legacy carto structural edges).
  ;; Run STANDALONE with hive-mcp STOPPED:
  ;;   clj -Sdeps "$(cat local.deps.edn)" -X:kg-rebuild              ; export-only
  ;;   clj -Sdeps "$(cat local.deps.edn)" -X:kg-rebuild :confirm? true
  :kg-rebuild
  {:exec-fn hive-mcp.scripts.kg-datahike-rebuild/rebuild!
   :exec-args {}
   :jvm-opts ["-Xmx32g"
              "-Xms8g"
              "-XX:+UseG1GC"
              "-XX:MaxGCPauseMillis=500"
              "-XX:+HeapDumpOnOutOfMemoryError"
              "--add-opens=java.base/jdk.internal.misc=ALL-UNNAMED"
              "--add-opens=java.base/java.nio=ALL-UNNAMED"
              "--add-modules=jdk.incubator.vector"]}

  :dev
  {:extra-paths ["dev" "test"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                cider/cider-nrepl {:mvn/version "0.58.0"}
                refactor-nrepl/refactor-nrepl {:mvn/version "3.11.0"}
                ;; --- Heap/RAM diagnostics (clojure-goes-fast). Toggleable via
                ;; hive-mcp.diag.heap; needs -Djdk.attach.allowAttachSelf=true
                ;; (clj-memory-meter self-attach) + DebugNonSafepoints (profiler).
                com.clojure-goes-fast/clj-memory-meter {:mvn/version "0.4.0"}
                com.clojure-goes-fast/jvm-alloc-rate-meter {:mvn/version "0.1.4"}
                com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.6.2"}}
   ;; Heap cap, G1GC tuning, string dedup, bounded core.async pool,
   ;; Netty access, Proximum HNSW SIMD, aggressive GC return-to-OS
   ;; -Xmx16g + SoftMaxHeapSize=12g bound the peak (KG load spikes);
   ;; -Xms2g floor lets idle committed heap settle at the ratio-driven
   ;; ~2.5g (working set ~1.75g post query-result-cache fix) instead of
   ;; pinning 4g. MinHeapFreeRatio=20/MaxHeapFreeRatio=40 + periodic GC
   ;; return the rest to the OS.
   :jvm-opts ["-Xmx16g"
              "-Xms2g"
              "-XX:+UseG1GC"
              "-XX:MaxGCPauseMillis=200"
              "-XX:+UseStringDeduplication"
              "-XX:G1PeriodicGCInterval=60000"
              "-XX:+G1PeriodicGCInvokesConcurrent"
              "-XX:MinHeapFreeRatio=20"
              "-XX:MaxHeapFreeRatio=40"
              "-XX:G1HeapRegionSize=4m"
              "-XX:+HeapDumpOnOutOfMemoryError"
              "-XX:+ExitOnOutOfMemoryError"
              "-Dclojure.core.async.pool-size=8"
              "--add-opens=java.base/jdk.internal.misc=ALL-UNNAMED"
              "--add-opens=java.base/java.nio=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"
              "--add-modules=jdk.incubator.vector"
              ;; --- RAM diagnostics enablement ---
              ;; clj-memory-meter attaches an agent to the running VM to size
              ;; live objects; JDK 25 forbids self-attach unless this is set.
              "-Djdk.attach.allowAttachSelf=true"
              ;; Accurate async-profiler stacks (alloc/CPU flamegraphs).
              "-XX:+UnlockDiagnosticVMOptions"
              "-XX:+DebugNonSafepoints"
              ;; NOTE: the JFR OldObjectSample leak recording (-XX:StartFlightRecording,
              ;; settings=leak.jfc) is added at the PRODUCTION launch point instead —
              ;; ~/dotfiles/.local/bin/blw/hive-mcp — so it runs only for the live
              ;; coordinator, not for ephemeral dev cider-jack-in REPLs (which would
              ;; name-collide on the singleton recording + write junk .jfr files).
              ;; --- RSS containment (HEAP-JVM-FLAGS kanban) ---
              ;; SoftMaxHeapSize makes G1 treat 12g as a soft ceiling and
              ;; uncommit toward it, returning RSS to the OS between peaks;
              ;; -Xmx16g stays the hard cap. ParallelRefProc speeds SoftRef
              ;; clearing; ExplicitGCInvokesConcurrent keeps our diag System/gc
              ;; calls concurrent instead of full STW.
              "-XX:SoftMaxHeapSize=12g"
              "-XX:+ParallelRefProcEnabled"
              "-XX:+ExplicitGCInvokesConcurrent"]}

  :nrepl
  {:extra-paths ["dev" "test"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                cider/cider-nrepl {:mvn/version "0.58.0"}
                refactor-nrepl/refactor-nrepl {:mvn/version "3.11.0"}
                ;; --- Heap/RAM diagnostics (clojure-goes-fast). Toggleable via
                ;; hive-mcp.diag.heap; needs -Djdk.attach.allowAttachSelf=true
                ;; (clj-memory-meter self-attach) + DebugNonSafepoints (profiler).
                com.clojure-goes-fast/clj-memory-meter {:mvn/version "0.4.0"}
                com.clojure-goes-fast/jvm-alloc-rate-meter {:mvn/version "0.1.4"}
                com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.6.2"}}
   ;; Heap cap, G1GC tuning, string dedup, bounded core.async pool,
   ;; Netty access, Proximum HNSW SIMD, aggressive GC return-to-OS
   ;; -Xmx16g + SoftMaxHeapSize=12g bound the peak (KG load spikes);
   ;; -Xms2g floor lets idle committed heap settle at the ratio-driven
   ;; ~2.5g (working set ~1.75g post query-result-cache fix) instead of
   ;; pinning 4g. MinHeapFreeRatio=20/MaxHeapFreeRatio=40 + periodic GC
   ;; return the rest to the OS.
   :jvm-opts ["-Xmx16g"
              "-Xms2g"
              "-XX:+UseG1GC"
              "-XX:MaxGCPauseMillis=200"
              "-XX:+UseStringDeduplication"
              "-XX:G1PeriodicGCInterval=60000"
              "-XX:+G1PeriodicGCInvokesConcurrent"
              "-XX:MinHeapFreeRatio=20"
              "-XX:MaxHeapFreeRatio=40"
              "-XX:G1HeapRegionSize=4m"
              "-XX:+HeapDumpOnOutOfMemoryError"
              "-XX:+ExitOnOutOfMemoryError"
              "-Dclojure.core.async.pool-size=8"
              "--add-opens=java.base/jdk.internal.misc=ALL-UNNAMED"
              "--add-opens=java.base/java.nio=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"
              "--add-modules=jdk.incubator.vector"
              ;; --- RAM diagnostics enablement ---
              ;; clj-memory-meter attaches an agent to the running VM to size
              ;; live objects; JDK 25 forbids self-attach unless this is set.
              "-Djdk.attach.allowAttachSelf=true"
              ;; Accurate async-profiler stacks (alloc/CPU flamegraphs).
              "-XX:+UnlockDiagnosticVMOptions"
              "-XX:+DebugNonSafepoints"
              ;; NOTE: the JFR OldObjectSample leak recording (-XX:StartFlightRecording,
              ;; settings=leak.jfc) is added at the PRODUCTION launch point instead —
              ;; ~/dotfiles/.local/bin/blw/hive-mcp — so it runs only for the live
              ;; coordinator, not for ephemeral dev cider-jack-in REPLs (which would
              ;; name-collide on the singleton recording + write junk .jfr files).
              ;; --- RSS containment (HEAP-JVM-FLAGS kanban) ---
              ;; SoftMaxHeapSize makes G1 treat 12g as a soft ceiling and
              ;; uncommit toward it, returning RSS to the OS between peaks;
              ;; -Xmx16g stays the hard cap. ParallelRefProc speeds SoftRef
              ;; clearing; ExplicitGCInvokesConcurrent keeps our diag System/gc
              ;; calls concurrent instead of full STW.
              "-XX:SoftMaxHeapSize=12g"
              "-XX:+ParallelRefProcEnabled"
              "-XX:+ExplicitGCInvokesConcurrent"]
   :main-opts ["-m" "nrepl.cmdline"
               "--port" "7910"
               "--middleware" "[cider.nrepl/cider-middleware,refactor-nrepl.middleware/wrap-refactor]"]}

  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                ;; Generative testing for spec validation
                org.clojure/test.check {:mvn/version "1.1.1"}
                ;; Trifecta macro: golden + property + mutation facets
                io.github.hive-agi/hive-test {:git/tag "v0.2.1" :git/sha "48b480f"}}
                ;; hive-spi now lives in :deps (core nses require it) — no
                ;; :test-alias override needed.
   ;; KG test isolation: force ephemeral in-memory DataScript so a cold test
   ;; JVM never opens (and konserve-lock-contends) the prod datahike store.
   :jvm-opts ["-Dhive.kg.backend=datascript"]
   :main-opts ["-m" "cognitect.test-runner"]}

  ;; CI-friendly: Run only unit tests (excludes tests requiring Emacs)
  :test-unit
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                org.clojure/test.check {:mvn/version "1.1.1"}
                io.github.hive-agi/hive-test {:git/tag "v0.2.1" :git/sha "48b480f"}}
   :jvm-opts ["-Dhive.kg.backend=datascript"]
   :main-opts ["-m" "cognitect.test-runner" "-e" ":integration"]
   :exec-fn cognitect.test-runner.api/test
   :exec-args {:excludes [:integration]}}

  ;; Run only integration tests (requires Emacs with emacs-mcp loaded)
  :test-integration
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                io.github.hive-agi/hive-test
                {:git/tag "v0.2.1" :git/sha "48b480f"}}
   :jvm-opts ["-Dhive.kg.backend=datascript"]
   :main-opts ["-m" "cognitect.test-runner" "-i" ":integration"]
   :exec-fn cognitect.test-runner.api/test
   :exec-args {:includes [:integration]}}

  ;; Uberjar build via tools.build (see build.clj)
  ;; Usage: clj -T:build uber
  ;;        clj -T:build uber :profile k8s-headless
  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}}
   :ns-default build}

;; Local dev overrides for sibling :local/root projects.
  ;; The hive-mcp launcher merges local.deps.edn via `clj -Sdeps` at startup.
  ;; Create local.deps.edn (gitignored) with :deps key, e.g.:
  ;;   {:deps {io.github.hive-agi/hive-events {:git/tag "v0.5.2" :git/sha "24a58a1"}}}
  ;; NOTE: Use :deps (top-level key), NOT :override-deps (alias-level only).
  }}
