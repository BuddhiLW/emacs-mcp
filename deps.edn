{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        org.clojure/core.async {:mvn/version "1.7.701"}

        ;; MCP SDK - BuddhiLW fork with async handler fix
        ;; Includes: graceful stdin EOF fix, dep upgrades, lsp4clj lint fix
        io.github.buddhilw/mcp-clojure-sdk
        {:git/tag "v0.1.1" :git/sha "49203a6"
         :exclusions [org.apache.logging.log4j/log4j-slf4j2-impl]}

        ;; Python interop for Claude Agent SDK bridge
        clj-python/libpython-clj {:mvn/version "2.026"}

        ;; nREPL client support
        nrepl/bencode {:mvn/version "1.2.0"}

        ;; Aleph for robust async TCP/networking (replaces custom sockets)
        aleph/aleph {:mvn/version "0.9.5"}
        manifold/manifold {:mvn/version "0.5.0"}

        ;; Logic programming for swarm hivemind coordination
        org.clojure/core.logic {:mvn/version "1.1.1"}

        ;; Time handling
        clj-time/clj-time {:mvn/version "0.15.2"}

        ;; Datascript for in-memory graph storage (GraphStore backend)
        datascript/datascript {:mvn/version "1.7.8"}
        ;; me.tonsky namespace for datascript/datahike: provided by local 0.3.118 jar.
        ;; org.replikativ namespace for Proximum: provided by hive-knowledge addon (0.4.119).
        ;; Different group IDs → both on classpath, non-overlapping namespaces.
        persistent-sorted-set/persistent-sorted-set-compat
        {:local/root "lib/persistent-sorted-set-0.3.118.jar"}

        ;; Datalevin for durable graph storage (GraphStore backend, optional)
        ;; LMDB-backed Datalog — requires Java 21+
        datalevin/datalevin {:mvn/version "0.10.5"}

        ;; Datahike for immutable graph storage with branching/time-travel
        ;; Content-addressable, supports branch/merge for multi-ling exploration
        ;; Part of replikativ ecosystem (pairs with yggdrasil)
        org.replikativ/datahike {:mvn/version "0.7.1650"}

        ;; Logging - SLF4J with Logback backend
        ;; clojure.tools.logging provides the Clojure facade
        ;; logback-classic is the SLF4J implementation
        ;; logstash-encoder provides JSON output for Loki/ELK ingestion
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        ch.qos.logback/logback-classic {:mvn/version "1.5.18"}
        net.logstash.logback/logstash-logback-encoder {:mvn/version "8.1"}
        ;; Keep Timbre for gradual migration (existing code uses it)
        ;; It will log to its own backend, not SLF4J
        com.taoensso/timbre {:mvn/version "6.8.0"}

        ;; Schema validation (malli)
        metosin/malli {:mvn/version "0.20.0"}

        ;; Chroma vector database client - BuddhiLW fork with v2 API support
        io.github.buddhilw/clojure-chroma-client
        {:git/tag "v0.1.0-hive" :git/sha "e575d5a"}

        ;; for openrouter integration
        clj-http/clj-http {:mvn/version "3.13.1"}

        ;; YAML parsing for seed memory frontmatter
        clj-commons/clj-yaml {:mvn/version "1.0.29"}

        ;; D-Bus client for native desktop notifications
        com.lambdaisland/dbus-client {:mvn/version "0.2.15"}

        ;; Development - tracing (hot reload via hive-hot)
        org.clojure/tools.trace {:mvn/version "0.9.0"}

        ;; clj-kondo for code analysis (call graphs, linting)
        ;; Exclude log4j-slf4j2-impl to avoid conflict with slf4j-timbre
        clj-kondo/clj-kondo {:mvn/version "2026.01.19"
                             :exclusions [org.apache.logging.log4j/log4j-slf4j2-impl]}

        ;; hive-events - re-frame inspired event system for JVM
        ;; v0.4.0 adds sub-FSM composition + multi-dispatch
        io.github.hive-agi/hive-events
        {:git/tag "v0.4.0" :git/sha "e3d9f7c"}

        ;; hive-hot - unified hot-reload with events integration
        io.github.hive-agi/hive-hot
        {:git/tag "v0.1.1" :git/sha "79aa403"}

        ;; Prometheus metrics - iapetos provides idiomatic Clojure wrapper
        ;; CLARITY-T: Telemetry first - observable system
        ;; hotspot collector provides JVM metrics (memory, GC, threads)
        clj-commons/iapetos {:mvn/version "0.1.14"}
        io.prometheus/simpleclient_hotspot {:mvn/version "0.16.0"}

        ;; NATS client for push-based drone notifications
        io.nats/jnats {:mvn/version "2.21.1"}

        ;; java-diff-utils for proper unified diff computation (hunks, context)
        ;; Used by drone diff protocol for token-efficient diff storage
        io.github.java-diff-utils/java-diff-utils {:mvn/version "4.15"}
        org.replikativ/yggdrasil {:mvn/version "0.2.20"}

        ;; Kabel — WebSocket transport for distributed Datahike writer backend
        ;; Symmetric peer-to-peer with middleware, transit/fressian serialization
        ;; Used by :kabel writer backend for real-time reactive KG writes
        io.replikativ/kabel {:mvn/version "0.3.92"}

        ;; Process execution - babashka.process for CLI wrappers
        ;; Used by overarch, scc, and other CLI tool integrations
        babashka/process {:mvn/version "0.6.25"}

        ;; hive-dsl — Result monad, rescue/guard DSL, error taxonomy
        io.github.hive-agi/hive-dsl
        {:git/tag "v0.3.7" :git/sha "d5decedcc8caceb8e6a699c9aae5c40db4ae7057"}

        ;; hive-emacs — Emacs vessel addon (IEditor, daemon, CIDER/Magit/Projectile)
        io.github.hive-agi/hive-emacs {:git/tag "v0.2.0" :git/sha "05a3a07"}
}

 :aliases
 {:mcp
  {:exec-fn hive-mcp.server.core/start!
   :exec-args {}
   :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                cider/cider-nrepl {:mvn/version "0.58.0"}}
   ;; Heap cap, G1GC tuning, string dedup for prompt/response data,
   ;; bounded core.async pool, Netty access
   :jvm-opts ["-Xmx4g"
              "-XX:+UseG1GC"
              "-XX:MaxGCPauseMillis=200"
              "-XX:+UseStringDeduplication"
              "-Dclojure.core.async.pool-size=8"
              "--add-opens=java.base/jdk.internal.misc=ALL-UNNAMED"
              "--add-opens=java.base/java.nio=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"]}

  :dev
  {:extra-paths ["dev" "test"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                cider/cider-nrepl {:mvn/version "0.58.0"}
                refactor-nrepl/refactor-nrepl {:mvn/version "3.11.0"}}
   ;; Heap cap, G1GC tuning, string dedup, bounded core.async pool,
   ;; Netty access, Proximum HNSW SIMD
   :jvm-opts ["-Xmx4g"
              "-XX:+UseG1GC"
              "-XX:MaxGCPauseMillis=200"
              "-XX:+UseStringDeduplication"
              "-Dclojure.core.async.pool-size=8"
              "--add-opens=java.base/jdk.internal.misc=ALL-UNNAMED"
              "--add-opens=java.base/java.nio=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"
              "--add-modules=jdk.incubator.vector"]}

  :nrepl
  {:extra-paths ["dev" "test"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                cider/cider-nrepl {:mvn/version "0.58.0"}
                refactor-nrepl/refactor-nrepl {:mvn/version "3.11.0"}}
   ;; Heap cap, G1GC tuning, string dedup, bounded core.async pool,
   ;; Netty access, Proximum HNSW SIMD
   :jvm-opts ["-Xmx4g"
              "-XX:+UseG1GC"
              "-XX:MaxGCPauseMillis=200"
              "-XX:+UseStringDeduplication"
              "-Dclojure.core.async.pool-size=8"
              "--add-opens=java.base/jdk.internal.misc=ALL-UNNAMED"
              "--add-opens=java.base/java.nio=ALL-UNNAMED"
              "-Dio.netty.tryReflectionSetAccessible=true"
              "--add-modules=jdk.incubator.vector"]
   :main-opts ["-m" "nrepl.cmdline"
               "--port" "7910"
               "--middleware" "[cider.nrepl/cider-middleware,refactor-nrepl.middleware/wrap-refactor]"]}

  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                ;; Generative testing for spec validation
                org.clojure/test.check {:mvn/version "1.1.1"}
                ;; hive-test: mutation, golden, property-based testing
                io.github.hive-agi/hive-test
                {:git/tag "v0.1.4" :git/sha "a529aa6"}}
   :main-opts ["-m" "cognitect.test-runner"]}

  ;; CI-friendly: Run only unit tests (excludes tests requiring Emacs)
  :test-unit
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                io.github.hive-agi/hive-test
                {:git/tag "v0.1.4" :git/sha "a529aa6"}}
   :main-opts ["-m" "cognitect.test-runner" "-e" ":integration"]
   :exec-fn cognitect.test-runner.api/test
   :exec-args {:excludes [:integration]}}

  ;; Run only integration tests (requires Emacs with emacs-mcp loaded)
  :test-integration
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                io.github.hive-agi/hive-test
                {:git/tag "v0.1.4" :git/sha "a529aa6"}}
   :main-opts ["-m" "cognitect.test-runner" "-i" ":integration"]
   :exec-fn cognitect.test-runner.api/test
   :exec-args {:includes [:integration]}}

;; Local dev overrides for sibling :local/root projects.
  ;; start-mcp.sh auto-merges deps.local.edn via -Sdeps when present.
  ;; Create deps.local.edn (gitignored) with :deps key, e.g.:
  ;;   {:deps {io.github.hive-agi/hive-events {:git/tag "v0.4.0" :git/sha "e3d9f7c"}}}
  ;; NOTE: Use :deps (top-level key), NOT :override-deps (alias-level only).
  }}
