{;; hive-mcp starter pack: the FOSS addons that turn the bare core into a
 ;; working harness. Merged on top of deps.edn through -Sdeps by
 ;; bin/hive-mcp-foss (HIVE_STARTER=0 opts out) and by the Dockerfile.
 ;; deps.edn itself stays free of every backend coordinate; this file is the
 ;; composition seam, the same one local.deps.edn uses for a personal setup.
 ;; It must start with "{": the clojure CLI reads any other -Sdeps argument
 ;; as a file path.
 ;;
 ;; Every coordinate below is on this list because a cold boot of the host
 ;; with this file merged was measured to mount or load it (2026-09-02). An
 ;; addon whose host tool is missing degrades with a logged reason; it does
 ;; not block the boot.
 :deps
 {;; --- vessels: where lings run -----------------------------------------
  ;; Each mounts when its host environment is reachable and stays dormant
  ;; otherwise, so having all three costs nothing when only one is present.
  ;; Emacs vessel + CIDER bridge.
  io.github.hive-agi/hive-emacs {:mvn/version "0.5.4"}
  ;; tmux vessel: IVessel + ITerminalAddon, panes through libtmux.
  io.github.hive-agi/hive-tmux {:mvn/version "0.1.1"}
  ;; Claude vessel: terminal + headless backends.
  io.github.hive-agi/hive-claude {:mvn/version "0.1.19"}

  ;; --- knowledge graph persistence ------------------------------------
  ;; Datahike is the core's default :kg-backend, so this store is what the
  ;; unconfigured boot persists into. To switch, set :kg-backend :datalevin
  ;; in .hive-project.edn (or -Dhive.kg.backend=datalevin) and swap in
  ;; io.github.hive-agi/hive-datalevin {:mvn/version "0.1.6"}.
  io.github.hive-agi/hive-datahike {:mvn/version "0.1.2"}

  ;; --- code intelligence ------------------------------------------------
  ;; Each contributes subcommands into the consolidated `code` supertool.
  ;; Measured 2026-09-02 with dev/addon_boot_probe.clj against these exact
  ;; published jars, no local roots and no hive-mcp on the addon's own
  ;; classpath: all four report :active.
  io.github.hive-agi/lsp-mcp         {:mvn/version "0.6.5"}
  io.github.hive-agi/clj-kondo-mcp   {:mvn/version "0.2.5"}
  io.github.hive-agi/scc-mcp         {:mvn/version "0.1.7"}
  io.github.hive-agi/basic-tools-mcp {:mvn/version "0.3.14"}}

 ;; --- pending: not in :deps yet, with the measured reason ----------------
 ;; Two faults used to keep the code-intelligence addons out of this list, and
 ;; both are now fixed and released, which is why they moved up:
 ;;
 ;;   1. The host discovers an addon only through its META-INF/hive-addons
 ;;      manifest, and the published jars shipped none: version.edn declared
 ;;      :src-dirs ["src"], so hive-build never copied the resources root.
 ;;   2. Each addon reified hive-mcp.addons.protocol/IAddon. reify resolves
 ;;      at compile time, so the namespace only loaded when the host had
 ;;      already required it: the jar was unmountable anywhere else. They now
 ;;      reify hive-addon.protocol/IAddon.
 ;;
 ;; What remains, each measured 2026-09-02 rather than assumed:
 ;;
 ;; hive-overarch 0.1.9 IS released and its jar ships the manifest, but the
 ;; boot probe reports ctor-unresolved: org.soulspace.overarch.domain.model is
 ;; not on the classpath. It consumes upstream overarch as a :git/sha coord,
 ;; and a published Maven pom cannot carry a git dependency, so the artifact
 ;; is unusable by a consumer even though the release is green. It returns
 ;; here when upstream overarch ships a thin jar to Maven.
 ;;
 ;; hive-proximum 0.1.18 mounts clean (:active). It is left out because it
 ;; registers a SECOND memory store under :proximum, which is a storage
 ;; choice, not part of a default harness. Add it deliberately.
 ;;
 ;;  io.github.hive-agi/hive-overarch  {:mvn/version "0.1.9"}
 ;;  io.github.hive-agi/hive-proximum  {:mvn/version "0.1.18"}
 }
