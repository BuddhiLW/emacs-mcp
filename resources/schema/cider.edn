;; CIDER tool parameter schemas — single source of truth.
;; Read by JVM (hive-mcp.schema.edn -> Malli) and Emacs (hive-mcp-schema -> parseedn).
;;
;; Malli-compatible EDN subset:
;;   :map, :string, :int, :enum, :maybe, :boolean, :keyword, :any
;;   Field props: {:optional true}, {:default V}, {:min N}, {:max N}
;;
;; Copyright (C) 2026 Pedro Gomes Branquinho (BuddhiLW) <pedrogbranquinho@gmail.com>
;; SPDX-License-Identifier: AGPL-3.0-or-later

{:cider/connect-session
 [:map
  [:name [:string {:min 1}]]
  [:host {:optional true :default "localhost"} :string]
  [:port [:int {:min 1 :max 65535}]]
  [:repl_type {:optional true :default "clj"} [:maybe [:enum "clj" "cljs" "cljel"]]]
  [:agent_id {:optional true} [:maybe :string]]]

 :cider/eval
 [:map
  [:code [:string {:min 1}]]
  [:session_name {:optional true} [:maybe :string]]
  [:mode {:optional true} [:enum "silent" "explicit"]]
  [:timeout {:optional true} [:int {:min 1}]]]

 :cider/spawn-session
 [:map
  [:name [:string {:min 1}]]
  [:project_dir {:optional true} [:maybe :string]]
  [:repl_type {:optional true :default "clj"} [:maybe [:enum "clj" "cljs" "cljel"]]]
  [:agent_id {:optional true} [:maybe :string]]]}
