;; K8s Headless profile — no Emacs, no stdio, A2A + WebSocket + NATS.
;; For Kubernetes deployments that need full coordination but no terminal.
;;
;; Merges over system.edn via meta-merge.
;; Keys set to nil are removed (Integrant exclusion convention).
;;
;; Copyright (C) 2026 Pedro Gomes Branquinho (BuddhiLW) <pedrogbranquinho@gmail.com>
;; SPDX-License-Identifier: AGPL-3.0-or-later

{:hive/mcp-stdio      nil
 :hive/legacy-channel  nil
 :hive/a2a-gateway    {:enabled true :port 7912}
 :hive/websocket-mcp  {:enabled true :port 7920}
 :hive/nats           {:enabled true}
 :hive/swarm-sync     {:source         :datahike
                       :event-backbone :nats}
 :hive/keepalive      {:signal :sigterm}}
