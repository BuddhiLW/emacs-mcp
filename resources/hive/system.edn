;; Integrant system map — base config (all 22 keys).
;; Profiles (desktop.edn, k8s-headless.edn, k8s-minimal.edn) merge over this
;; via meta-merge to add/remove/override keys per deployment target.
;;
;; Dependency edges use #ig/ref — Integrant topologically sorts init order.
;; halt-key! runs in reverse init order automatically.
;;
;; Copyright (C) 2026 Pedro Gomes Branquinho (BuddhiLW) <pedrogbranquinho@gmail.com>
;; SPDX-License-Identifier: AGPL-3.0-or-later

{;; ── Layer 1: Guards, Hooks, Events, Coordinator ──────────────────────
 :hive/guards          {}
 :hive/hooks           {:guards (ig/ref :hive/guards)
                        :coordinator-id (ig/ref :hive/coordinator)}
 :hive/events          {}
 :hive/delivery-channels {}
 :hive/coordinator     {}

 ;; ── Layer 2: Transport (network servers) ─────────────────────────────
 :hive/nrepl           {:port 7910}
 :hive/websocket-mcp   {:enabled false}
 :hive/nats            {:enabled false}

 ;; ── Layer 3: Services (embedding, memory, config, extensions) ────────
 :hive/embedding       {}
 :hive/memory-store    {:embedding (ig/ref :hive/embedding)}
 :hive/tool-delegation {:memory (ig/ref :hive/memory-store)}
 :hive/forge-belt      {}
 :hive/config          {}
 :hive/extensions      {:config    (ig/ref :hive/config)
                        :embedding (ig/ref :hive/embedding)}

 ;; ── Layer 4: Channels + Sync ─────────────────────────────────────────
 :hive/ws-channel      {:port 9999}
 :hive/olympus         {}
 :hive/a2a-gateway     {:enabled false}
 :hive/legacy-channel  {:port 9998}
 :hive/channel-bridge  {:events     (ig/ref :hive/events)
                        :ws-channel (ig/ref :hive/ws-channel)}
 :hive/swarm-sync      {:channel-bridge (ig/ref :hive/channel-bridge)
                        ;; :nats ref is a dependency edge only — ensures the
                        ;; backbone is up before the event bridge subscribes.
                        :nats           (ig/ref :hive/nats)
                        ;; :source resolves from services.swarm-sync.source
                        ;; in config.edn when omitted. Valid: :emacs (legacy)
                        ;; | :datahike (persistent KV) | :none.
                        :source nil
                        ;; :event-backbone resolves from
                        ;; services.swarm-sync.event-backbone in config.edn
                        ;; when nil. Valid: :local (default) | :nats.
                        :event-backbone nil}
 :hive/workflow-engine {:extensions (ig/ref :hive/extensions)
                        :memory     (ig/ref :hive/memory-store)}

 ;; ── Layer 5: Hot-reload, Schedulers, Stdio ───────────────────────────
 :hive/hot-reload      {:extensions (ig/ref :hive/extensions)}
 :hive/registry-sync   {:swarm-sync (ig/ref :hive/swarm-sync)}
 :hive/decay-scheduler {:embedding (ig/ref :hive/embedding)}
 :hive/housekeeping    {}
 :hive/mcp-stdio       {:tool-delegation (ig/ref :hive/tool-delegation)
                        :hot-reload      (ig/ref :hive/hot-reload)}
 :hive/keepalive       {:mode :stdio}}
